{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nameonmymind:schema:korean-expression-ladder:v1.0.0",
  "title": "NameOnMyMind Korean Expression Ladder v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "track_id", "purpose", "principles", "lexemes", "ladders"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "track_id": {"const": "KOREAN_EXPRESSIVE_CHOICE"},
    "purpose": {"type": "string", "minLength": 20},
    "principles": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 10}
    },
    "lexemes": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id","expression","pos","function","register","meaning","nuance","example","source","status"],
        "properties": {
          "id": {"type":"string","pattern":"^KX[0-9]{4}$"},
          "expression": {"type":"string","minLength":1},
          "pos": {"type":"string","minLength":1},
          "function": {"type":"string","minLength":1},
          "register": {"enum":["neutral","everyday","formal","literary","marked"]},
          "meaning": {"type":"string","minLength":10},
          "nuance": {"type":"string","minLength":10},
          "example": {"type":"string","minLength":5},
          "source": {
            "type":"object",
            "additionalProperties":false,
            "required":["provider","url","source_type","verified_at"],
            "properties":{
              "provider":{"type":"string","minLength":1},
              "url":{"type":"string","format":"uri"},
              "source_type":{"enum":["dictionary","official_qna","official_example"]},
              "verified_at":{"type":"string","format":"date"}
            }
          },
          "status":{"enum":["LEXICAL_PASS","USAGE_PASS","HOLD"]}
        }
      }
    },
    "ladders": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type":"object",
        "additionalProperties":false,
        "required":["id","speech_function","common_expression","choice_rule","options","child_prompt"],
        "properties":{
          "id":{"type":"string","pattern":"^KL[0-9]{3}$"},
          "speech_function":{"type":"string","minLength":1},
          "common_expression":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
          "choice_rule":{"type":"string","minLength":15},
          "options":{
            "type":"array","minItems":2,
            "items":{
              "type":"object","additionalProperties":false,
              "required":["expression","when_to_use","example"],
              "properties":{
                "expression":{"type":"string","minLength":1},
                "when_to_use":{"type":"string","minLength":8},
                "example":{"type":"string","minLength":5}
              }
            }
          },
          "child_prompt":{"type":"string","minLength":10}
        }
      }
    }
  }
}
