{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nameonmymind:schema:asset-registry:v1.0.0",
  "title": "NameOnMyMind Asset Provenance Registry v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assets"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/asset"}
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "card_id", "asset_type", "path", "source_or_generation_method", "license_or_rights_basis", "review_status", "reviewed_at"],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^A[0-9]{4,}$"},
        "card_id": {"type": "string", "pattern": "^C[0-9]{4}$"},
        "asset_type": {"enum": ["illustration", "share", "pronunciation_audio"]},
        "path": {"type": "string", "minLength": 1},
        "source_or_generation_method": {"type": "string", "minLength": 1},
        "source_url": {"type": ["string", "null"], "format": "uri"},
        "creator_or_model": {"type": ["string", "null"]},
        "license_or_rights_basis": {"type": "string", "minLength": 1},
        "attribution": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "review_status": {"enum": ["AUTOMATED_PASS", "HUMAN_APPROVED", "HOLD"]},
        "reviewed_at": {"type": "string", "format": "date"}
      }
    }
  }
}
